# ==============================================================================
# RE/MAX One Rentals Intranet - environment configuration
# Copy this file to `.env` and fill in every value. NEVER commit `.env`.
# ==============================================================================

# --- App -----------------------------------------------------------------
# The public URL of the app. http://localhost:3000 in development.
NEXTAUTH_URL="http://localhost:3000"

# Random 32+ char secret used to sign session tokens.
# Generate with:  openssl rand -base64 32   (or any password generator)
NEXTAUTH_SECRET="change-me-to-a-long-random-string"

# --- Google Sign-In (OAuth 2.0 Web Client) ---------------------------------
# Created in Google Cloud Console > APIs & Services > Credentials.
GOOGLE_CLIENT_ID="xxxxxxxx.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="xxxxxxxx"

# Comma-separated list of email domains allowed to sign in.
# Only accounts on these domains can log in (the "company email" rule).
ALLOWED_EMAIL_DOMAINS="remax-one.co.za"

# --- Google Sheets read access (Service Account) ----------------------------
# Created in Google Cloud Console > IAM & Admin > Service Accounts.
# ALL 7 workflow tracker spreadsheets must be SHARED (Viewer) with this email -
# the 5 original ones PLUS the new Queries and POP trackers. If you forget the
# new two, "My Queries" and "My POPs" will show a red "could not load" error.
GOOGLE_SERVICE_ACCOUNT_EMAIL="intranet-reader@your-project.iam.gserviceaccount.com"
# Paste the private key from the downloaded JSON key file. Keep the quotes and
# keep the \n escapes exactly as they appear in the JSON file.
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEv...\n-----END PRIVATE KEY-----\n"

# --- Database ----------------------------------------------------------------
# Dev default: local SQLite file (zero setup).
# Production: switch prisma/schema.prisma provider to "postgresql" and use e.g.
# DATABASE_URL="postgresql://user:pass@host:5432/intranet?schema=public"
DATABASE_URL="file:./dev.db"

# --- Sheet column overrides (optional) -----------------------------------------
# The column that holds the AGENT'S NAME in each tracker sheet, as a column
# letter. Defaults live in src/config/sheets.ts - verify them against your
# actual sheets and override here if they differ.
# SHEETS_LEASES_AGENT_COL="C"
# SHEETS_BILLING_AGENT_COL="B"
# SHEETS_MAINTENANCE_AGENT_COL="B"
# SHEETS_DEPOSITS_AGENT_COL="C"
# SHEETS_RENEWALS_AGENT_COL="B"
#
# The Queries and POP trackers have NO guesses: the app reads their header row
# and finds the agent column itself (an "Agent email address" column is used in
# preference to a name, because email is an exact match). Only set these two if
# the page tells you it could not work the column out.
# SHEETS_QUERIES_AGENT_COL="C"
# SHEETS_POPS_AGENT_COL="B"
